# Server
PORT=3000
MONGODB_URI=mongodb://localhost:27017/activation-service

# AuthService — RS256 public key fetched once at startup from AUTH_SERVICE_URL/jwt/public-key
AUTH_SERVICE_URL=https://auth.freischule.info
# Optional: skip the network round-trip (used in tests/CI) and use this PEM directly instead
AUTH_JWT_PUBLIC_KEY=

# Internal service-to-service auth — one key per caller, never a shared master key
INTERNAL_API_KEY_BILLING_SERVICE=
INTERNAL_API_KEY_WAVE_SERVICE=

# Redis — rate-limit counters (cooldown, daily user cap, hourly location cap)
REDIS_URL=redis://localhost:6379

# AES-256-GCM key for encrypting Location.totpSecret at rest. Hex-encoded, exactly 32 bytes
# (64 hex chars). Required (and length-checked) outside of NODE_ENV=test — the service refuses
# to start without it. Generate: openssl rand -hex 32
SECRET_ENC_KEY=

# HMAC key signing every Checkin, making billing data tamper-evident after the fact. Also
# derives the pseudonymous `userRef` in merchant-facing check-in lists (GDPR). Required
# (min 32 chars) outside of NODE_ENV=test.
CHECKIN_SIGNING_KEY=

# Rate limits
CHECKIN_COOLDOWN_H=4
LOCATION_HOURLY_CAP=300

# ProfileService — fire-and-forget XP event on every verified check-in
PROFILE_SERVICE_URL=https://profile.freischule.info
PROFILE_SERVICE_API_KEY=

# WaveService — fire-and-forget stats.checkins increment for check-ins in a wave context
WAVE_SERVICE_URL=https://wave.freischule.info
WAVE_SERVICE_API_KEY=

# ExceptionService — unhandled error reporting and fraud signals
EXCEPTION_SERVICE_URL=https://exception.freischule.info
EXCEPTION_SERVICE_API_KEY=
