{
  "name": "activation-service",
  "version": "1.0.0",
  "description": "Verifies physical presence (check-ins) at merchant/event locations for WavyMania",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "jest --runInBand"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "h3-js": "^4.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.3",
    "speakeasy": "^2.0.0"
  },
  "devDependencies": {
    "ioredis-mock": "^8.9.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.4.1",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testTimeout": 60000,
    "setupFiles": [
      "<rootDir>/tests/setup/env.js"
    ],
    "moduleNameMapper": {
      "^ioredis$": "<rootDir>/tests/mocks/ioredisMock.js"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/setup/",
      "/tests/mocks/",
      "/tests/helpers/"
    ]
  }
}
